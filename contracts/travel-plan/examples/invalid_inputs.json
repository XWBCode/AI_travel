          "path": "slots.startDate",
          "op": "isNull"
        }
      ]
    },
    {
      "id": "IN-19",
      "category": "不合理日期",
      "input": "去丽江玩三天，2020-01-01 到 2020-01-03",
      "expect": "过去日期可以解析但不该被当成未来行程误推天数",
      "asserts": [
        {
          "path": "slots.days",
          "op": "eq",
          "value": 3
        }
      ]
    },
    {
      "id": "IN-20",
      "category": "不合理日期",
      "input": "去成都三天，12月20日出发，12月18日回来",
      "expect": "结束早于开始，不能算出负天数",
      "asserts": [
        {
          "path": "slots.days",
          "op": "gte",
          "value": 1
        }
      ]
    },
