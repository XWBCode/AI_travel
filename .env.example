# ============================================================
# 复制本文件为 .env，按实际环境填写
# 注意：.env 不要提交到 Git
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_travel
MYSQL_USER=root
MYSQL_PASSWORD=你自己的密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Java ----------
SERVER_PORT=8080
# 生产环境必须替换为随机长字符串（>=32 字节）
JWT_SECRET=change-me-to-a-random-32-bytes-string-xxxxx
CORS_ORIGINS=http://localhost:5173

# ---------- Python AI 服务 ----------
AI_SERVICE_PORT=8000
# mock：不调用真实模型，用于本地打通链路（会在响应里明确标注 [MOCK]）
# openai_compatible：调用任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi 等）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048

# Java 找 Python 的地址
AI_SERVICE_URL=http://localhost:8000
