# ============================================================
# 复制本文件为 .env，按实际环境填写
# 注意：.env 不要提交到 Git
# ============================================================

# ---------- MySQL ----------
# 环境约定（docs/design/06 §1）：dev 用独立库 ai_travel_dev，不与 test/prod 共用
# 首次使用先建库与专用账号（用管理员账号执行，替换占位口令）：
#   CREATE DATABASE ai_travel_dev DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   CREATE USER 'ai_travel'@'localhost' IDENTIFIED BY '<你的口令>';
#   GRANT ALL PRIVILEGES ON ai_travel_dev.* TO 'ai_travel'@'localhost';
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_travel_dev
MYSQL_USER=ai_travel
MYSQL_PASSWORD=你自己的密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 环境标识 ----------
# dev | test | prod。生产**必须**显式设 prod。
# Java 侧读 SPRING_PROFILES_ACTIVE；Python 侧优先读 APP_ENV，缺失时回退读 SPRING_PROFILES_ACTIVE。
# 一个部署只需要设一个（就是下面那个 SPRING_PROFILES_ACTIVE），不必为 Python 再写一遍。
# 两边都留空时按「未声明环境」处理，数据源合规闸门会拒绝 open-meteo（fail-closed）。

# ---------- Java ----------
# dev / prod；prod 下所有敏感项必须由环境变量注入，无默认值
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 生产环境必须替换为随机长字符串（>=32 字节）
JWT_SECRET=change-me-to-a-random-32-bytes-string-xxxxx
CORS_ORIGINS=http://localhost:5173

# ---------- Python AI 服务 ----------
AI_SERVICE_PORT=8000
# mock：不调用真实模型，用于本地打通链路（会在响应里明确标注 [MOCK]）
# openai_compatible：调用任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi 等）
LLM_PROVIDER=mock
# 方案 A：DeepSeek 官方直连（快，3 天计划约 14s，按量付费）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 方案 B：交融网关（OpenAI 兼容，公司内网额度；实测 3 天 60–130s、7 天 160–210s，务必配 300s 读超时）
# LLM_BASE_URL=https://c4ai.ccccltd.cn/api/compatible/v1
# 旗舰档里合规最稳的是 v4-pro（12/12），备选 kimi-k2.6（快 3 倍但 missingFields 规则不稳）
# LLM_MODEL=jiaorong-deepseek-v4-pro
# 验证 key 是否有效（返回模型列表即可用，返回 invalid apikey 就是失效）：
#   curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_KEY=
# 切真实模型时：max_tokens 给 8192（2048 会把计划 JSON 截断），
# timeout 要小于 Java 的读超时（默认 300s）；网关链路建议 240
LLM_TIMEOUT_SECONDS=120
# Java 侧三个超时（毫秒）：读流 / 计划生成 / 调整建议，网关链路都要给足
# AI_READ_TIMEOUT_MS=300000
# AI_PLAN_TIMEOUT_MS=300000
# AI_ADJUST_TIMEOUT_MS=180000
# 流式并发：并行度 = 同时进行的生成数，排队上限默认 0（满了立刻 10429，而不是静默排队）
# 8 并发实测 P50 132.7s（串行 127.4s）；要提并发请提线程数，不要提排队——
# 队列会把「等 5 分钟」藏起来，还会吃掉 SSE 连接预算（见可靠性报告 §5.3）
# AI_STREAM_POOL_SIZE=8
# AI_STREAM_QUEUE_CAPACITY=0
LLM_MAX_TOKENS=2048

# Java 找 Python 的地址
AI_SERVICE_URL=http://localhost:8000

# ---------- 天气（M3-1 / D-03）----------
# none（默认）| qweather（生产）| open-meteo（仅 dev/test）
# 默认 none 是刻意的：和风天气凭据不在仓库里，默认开着只会让每个部署先吃一次 401，
# 还可能触发对方风控（官方明确写了持续错误请求可能导致帐号冻结）。
# open-meteo 保留但只允许在 dev / test 启动：其免费端点禁商用、数据以 CC BY 4.0 发布（须署名）。
# 在 prod 配 open-meteo 会让**应用直接启动失败**（不是降级、不是告警）——
# 这类违规没有任何用户可见的异常，只能让进程起不来才会被发现。
WEATHER_PROVIDER=none
# 查询超时（毫秒）。天气是页面附属信息，慢到 5s 就降级，别让详情页跟着等
WEATHER_TIMEOUT_MS=5000
# 缓存时长（分钟）。官方「逐天预报推荐 1–6 小时」，取 1 小时；
# 另有硬边界「次日 00:10 必须失效」（跨天不刷新会整体错一天），在代码里兜底
WEATHER_CACHE_TTL_MINUTES=60

# ---------- 和风天气凭据（D-03，仅 provider=qweather 时需要）----------
# 全部从控制台复制，不要凭记忆拼：
#   API Host     → console.qweather.com/setting   专属域名，填错会 403 INVALID HOST
#   开发者ID      → console.qweather.com/setting   Q 开头 10 位
#   项目ID/凭据ID → console.qweather.com/project   凭据要选「JSON Web Token」并上传公钥
# 私钥用文件路径，不要写进这里，也不要提交（.gitignore 已含 *.pem / *.key）：
#   openssl genpkey -algorithm ED25519 -out ed25519-private.pem
#   openssl pkey -pubout -in ed25519-private.pem > ed25519-public.pem
# QWEATHER_API_HOST=
# QWEATHER_DEVELOPER_ID=
# QWEATHER_PROJECT_ID=
# QWEATHER_KEY_ID=
# QWEATHER_PRIVATE_KEY_PATH=./secrets/ed25519-private.pem

# ---------- 调整期天气灰度的白名单（M3-3 · S5）----------
# 三件事必须同时成立才会真的查天气：inject_on_adjust=true、数据源已启用、这次请求被放行。
# 默认 false = 全站关闭，行为与加这个功能之前逐字相同。
WEATHER_INJECT_ON_ADJUST=false
# 内部账号白名单（逗号分隔的 t_user.id）。空 = prod 不注入（fail-closed）；
# dev/test 下空 = 整个实例视为内部实例（本地与 CI 靠这条跑端到端）。
# 名单只在服务端，不进前端、不入库、不写 config.yaml。
WEATHER_INJECT_ADJUST_USERS=
# 运行时急停：该文件存在就立刻停止注入，不用重启进程（运维 touch 一下即可）。
WEATHER_INJECT_ADJUST_KILL_FILE=
# Java ⇄ Python 内部共享密钥：Java 用它给 X-User-Id 签 HMAC，Python 用同一个值验签。
# 两边必须同值。空 = 发不出可信身份 = 灰度不生效（安全的默认）。
# 生成方式：openssl rand -hex 32
AI_INTERNAL_SECRET=
