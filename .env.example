# ============================================================
# 复制本文件为 .env，按实际环境填写
# 注意：.env 不要提交到 Git
# ============================================================

# ---------- MySQL ----------
# 环境约定（docs/design/06 §1）：dev 用独立库 ai_travel_dev，不与 test/prod 共用
# 首次使用先建库与专用账号（用管理员账号执行，替换占位口令）：
#   CREATE DATABASE ai_travel_dev DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   CREATE USER 'ai_travel'@'localhost' IDENTIFIED BY '<你的口令>';
#   GRANT ALL PRIVILEGES ON ai_travel_dev.* TO 'ai_travel'@'localhost';
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_travel_dev
MYSQL_USER=ai_travel
MYSQL_PASSWORD=你自己的密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Java ----------
# dev / prod；prod 下所有敏感项必须由环境变量注入，无默认值
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 生产环境必须替换为随机长字符串（>=32 字节）
JWT_SECRET=change-me-to-a-random-32-bytes-string-xxxxx
CORS_ORIGINS=http://localhost:5173

# ---------- Python AI 服务 ----------
AI_SERVICE_PORT=8000
# mock：不调用真实模型，用于本地打通链路（会在响应里明确标注 [MOCK]）
# openai_compatible：调用任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi 等）
LLM_PROVIDER=mock
# 方案 A：DeepSeek 官方直连（快，3 天计划约 14s，按量付费）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 方案 B：交融网关（OpenAI 兼容，公司内网额度；实测 3 天 60–130s、7 天 160–210s，务必配 300s 读超时）
# LLM_BASE_URL=https://c4ai.ccccltd.cn/api/compatible/v1
# 旗舰档里合规最稳的是 v4-pro（12/12），备选 kimi-k2.6（快 3 倍但 missingFields 规则不稳）
# LLM_MODEL=jiaorong-deepseek-v4-pro
# 验证 key 是否有效（返回模型列表即可用，返回 invalid apikey 就是失效）：
#   curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_KEY=
# 切真实模型时：max_tokens 给 8192（2048 会把计划 JSON 截断），
# timeout 要小于 Java 的读超时（默认 300s）；网关链路建议 240
LLM_TIMEOUT_SECONDS=120
# Java 侧三个超时（毫秒）：读流 / 计划生成 / 调整建议，网关链路都要给足
# AI_READ_TIMEOUT_MS=300000
# AI_PLAN_TIMEOUT_MS=300000
# AI_ADJUST_TIMEOUT_MS=180000
LLM_MAX_TOKENS=2048

# Java 找 Python 的地址
AI_SERVICE_URL=http://localhost:8000
