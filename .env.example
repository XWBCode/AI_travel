# ============================================================
# 复制本文件为 .env，按实际环境填写
# 注意：.env 不要提交到 Git
# ============================================================

# ---------- MySQL ----------
# 环境约定（docs/design/06 §1）：dev 用独立库 ai_travel_dev，不与 test/prod 共用
# 首次使用先建库与专用账号（用管理员账号执行，替换占位口令）：
#   CREATE DATABASE ai_travel_dev DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   CREATE USER 'ai_travel'@'localhost' IDENTIFIED BY '<你的口令>';
#   GRANT ALL PRIVILEGES ON ai_travel_dev.* TO 'ai_travel'@'localhost';
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_travel_dev
MYSQL_USER=ai_travel
MYSQL_PASSWORD=你自己的密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Java ----------
# dev / prod；prod 下所有敏感项必须由环境变量注入，无默认值
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 生产环境必须替换为随机长字符串（>=32 字节）
JWT_SECRET=change-me-to-a-random-32-bytes-string-xxxxx
CORS_ORIGINS=http://localhost:5173

# ---------- Python AI 服务 ----------
AI_SERVICE_PORT=8000
# mock：不调用真实模型，用于本地打通链路（会在响应里明确标注 [MOCK]）
# openai_compatible：调用任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi 等）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048

# Java 找 Python 的地址
AI_SERVICE_URL=http://localhost:8000
