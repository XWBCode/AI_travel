{
  "version": 2,
  "note": "AC-07 畸形输入样例集（意图/输入层）。结构与字段层的畸形样例见同目录 invalid_cases.json。两侧合计 ≥ 50 组。每条的 asserts 必须可机器判定，不允许只写说明。",
  "categories": [
    "缺少目的地",
    "缺少出行天数",
    "地点歧义",
    "不合理日期",
    "不合理天数",
    "空输入与超长输入",
    "非旅行需求",
    "混合多种意图",
    "错误地点实体无法解析"
  ],
  "cases": [
    {
      "id": "IN-01",
      "category": "缺少目的地",
      "input": "我想出去玩三天",
      "expect": "没有目的地就不该生成计划，只问目的地",
      "asserts": [
        {
          "path": "needPlan",
          "op": "eq",
          "value": false
        },
        {
          "path": "missingFields",
          "op": "contains",
          "value": "destination"
        }
      ]
    },
    {
      "id": "IN-02",
      "category": "缺少目的地",
